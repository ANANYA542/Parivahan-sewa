{
  "name": "@parivahan/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build --workspace @parivahan/shared && tsx watch --env-file=.env src/main.ts",
    "prebuild": "npm run build --prefix ../packages/shared",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "npm run build --workspace @parivahan/shared && node --env-file=.env --import tsx prisma/seed.ts"
  },
  "dependencies": {
    "@parivahan/shared": "file:../packages/shared",
    "@nestjs/common": "^10.4.2",
    "@nestjs/core": "^10.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.2",
    "@prisma/client": "^5.18.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "prisma": "^5.18.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
