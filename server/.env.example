# Required
JWT_SECRET=replace-with-any-random-string
GROQ_API_KEY=get-a-free-key-at-https://console.groq.com

# Required — users, vehicles, and cases are persisted here (see prisma/schema.prisma).
# The service catalog itself stays static in-code (packages/shared), not in this database.
# For serverless deployment (Vercel), append ?connection_limit=5&pool_timeout=10 to keep a
# direct Postgres connection from being exhausted by many concurrent function instances.
DATABASE_URL=postgresql://user:password@localhost:5432/parivahan_track?connection_limit=5&pool_timeout=10

# Optional — sensible defaults are used if left unset
# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173
