# Required
JWT_SECRET=replace-with-any-random-string
GROQ_API_KEY=get-a-free-key-at-https://console.groq.com

# Optional — sensible defaults are used if left unset
# PORT=4000
# CLIENT_ORIGIN=http://localhost:5173

# Not read by the running app today — a Prisma schema exists (server/prisma/schema.prisma)
# for a future Postgres swap, but this build deliberately runs on an in-memory,
# seeded repository (see the root README's "What's real vs. mocked" table).
# DATABASE_URL=postgresql://user:password@localhost:5432/parivahan_track
