generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId            String   @id @default(cuid())
  name              String
  contact           String
  preferredLanguage String   @default("en")
  mobilityScore     Int?     @default(0)
  vehicles          Vehicle[]
  cases             Case[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Vehicle {
  vehicleId         String   @id @default(cuid())
  ownerId           String
  registrationNumber String  @unique
  vehicleType       String
  documentStatus    Json
  owner             User     @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
  cases             Case[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Service {
  serviceId          String   @id @default(cuid())
  name               String
  category           String
  steps              Json
  requiredDocuments  Json
  cases              Case[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Case {
  caseId        String   @id @default(cuid())
  type          String
  userId        String
  vehicleId     String?
  serviceId     String
  stage         String
  status        String
  slaDeadline   DateTime?
  submissionData Json
  stageHistory   Json
  user          User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [vehicleId], onDelete: SetNull)
  service       Service  @relation(fields: [serviceId], references: [serviceId], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
