# Leave VITE_API_URL unset for local development. Vite proxies /v1 to Nest.
# Set this only when deploying the client separately from its API.
# VITE_API_URL=https://api.example.com/v1

# Optional local proxy target if the Nest server runs on a non-default port.
# VITE_API_PROXY_TARGET=http://127.0.0.1:4000
